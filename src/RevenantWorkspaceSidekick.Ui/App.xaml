<Application x:Class="RevenantWorkspaceSidekick.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared Revenant house theme (obsidian / gold / turquoise).
                     The identical file is meant to ship in Warden too. Read the
                     header comment in RevenantTheme.xaml before changing a color. -->
                <ResourceDictionary Source="Theme/RevenantTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
