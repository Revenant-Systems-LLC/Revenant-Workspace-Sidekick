<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RevenantWorkspaceSidekick.Ui</AssemblyName>
    <RootNamespace>RevenantWorkspaceSidekick.Ui</RootNamespace>
    <ApplicationIcon>Assets\RWS_VegVisir.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevenantWorkspaceSidekick.Core\RevenantWorkspaceSidekick.Core.csproj" />
    <ProjectReference Include="..\RevenantWorkspaceSidekick.Rules\RevenantWorkspaceSidekick.Rules.csproj" />
  </ItemGroup>

  <!-- Brand assets. Fonts MUST be <Resource> (not Content) for the
       pack://application:,,,/Assets/#Family syntax to resolve. -->
  <ItemGroup>
    <!-- Street Reich  = titles / headers
         Sell Your Soul = regular body text
         Ghost Theory 1 = secondary body text
         (Ghost Theory 2 was dropped at Dave's call, 2026-07-30.) -->
    <Resource Include="Assets\Street Reich.otf" />
    <Resource Include="Assets\Sell Your Soul.ttf" />
    <Resource Include="Assets\Ghost theory 1.ttf" />
    <Resource Include="Assets\RWS_Wordmark.png" />
    <Resource Include="Assets\RWS_Mark.png" />

    <!-- The one and only background image: a seamless hex tile. Everything else
         that was tried — tex-hex, tex-circuit-wide, tex-circuit-square, tex-marble,
         Circuits.png — is unreferenced. Textured card backs were pulled ("it looks
         messy") and the animated background was scrapped. Those files are still in
         Assets\ but none of them ship. -->
    <Resource Include="Assets\tex-hextiles.jpg" />

    <!-- Company branding, distinct from the product mark/wordmark above.
         Revenant Systems owns the app; Workspace Sidekick is the product. -->
    <Resource Include="Assets\RevSys_Wordmark_Turquoise.png" />
    <Resource Include="Assets\VegVisir_Turquoise.png" />

    <!-- The app icon: the Vegvisir as a 7-frame .ico (16/24/32/48/64/128/256),
         built from VegVisir_Turquoise.png 2026-08-09 at Dave's direction.

         ⚠ THE .ico IS FOR <ApplicationIcon> ONLY — the exe's icon, which Windows
         reads as a proper icon group and picks the right frame from.

         Do NOT point the Window's Icon="..." at it. WPF's XAML icon path
         (ImageSourceConverter, BitmapFrame.Create and BitmapImage all behave the
         same) takes Frames[0] of a multi-frame .ico, which is the 16x16 — and
         then Windows upscales that mush into alt-tab and the taskbar. Measured
         2026-08-09: this .ico via the XAML path yields 16x16; the PNG yields
         1024x1008. That is why MainWindow.xaml uses VegVisir_Turquoise.png for
         Icon= and this file is referenced only by ApplicationIcon above. -->
    <Resource Include="Assets\RWS_VegVisir.ico" />
    <!-- THE company logo — obsidian and gold skull inside the runic hex frame.
         Sits left of REVENANT SYSTEMS in the footer. Distinct from the Vegvisir,
         which now fills the grade ring until a scan produces a grade. -->
    <Resource Include="Assets\RevSys_Logo.png" />
  </ItemGroup>

  <!-- Assets\Background.mp4 used to be copied to the output here for the animated
       background. That feature is gone (see MainWindow.xaml) and shipping a video
       nothing plays is dead weight, so it is no longer referenced. The file is
       still in Assets\ if it is ever wanted again. -->
</Project>
