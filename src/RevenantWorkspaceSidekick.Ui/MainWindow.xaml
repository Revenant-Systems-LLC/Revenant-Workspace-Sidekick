<Window x:Class="RevenantWorkspaceSidekick.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RevenantWorkspaceSidekick.Ui.ViewModels"
        Title="Revenant Workspace Sidekick"
        Height="820" Width="1320"
        MinHeight="620" MinWidth="1040"
        Icon="Assets/RWS_Mark.png"
        Background="{StaticResource BgApp}"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One severity card. Big numeral, colored rule down the left edge,
             faint wash behind. Four of these are the point of the app. -->
        <Style x:Key="SevCard" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="SevNumeral" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="52"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="56"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="SevName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <!-- Obsidian base, circuit texture over it, everything else floats on top
         at partial alpha so the texture reads through. -->
    <Grid>
        <!-- Animated obsidian circuit board. 4.375s seamless loop (frames 1-105
             of the source, cut on Dave's frame pair; last->first differs by a
             mean of 3.1 levels out of 255, so no crossfade needed).

             Opacity 0.28, matching Warden. Dave's call: it was faded enough at
             0.28 that it wasn't overtaking anything. A prior pass dropped this
             to 0.12 and that was wrong. Do not "fix" it again without asking.

             The still Circuits.png is still in Assets as a fallback. -->
        <MediaElement x:Name="BackgroundVideo"
                      Source="Assets/Background.mp4"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      IsMuted="True"
                      Volume="0"
                      Stretch="UniformToFill"
                      Opacity="0.28"
                      IsHitTestVisible="False"
                      MediaOpened="BackgroundVideo_MediaOpened"
                      MediaEnded="BackgroundVideo_MediaEnded"
                      MediaFailed="BackgroundVideo_MediaFailed"/>

        <!-- Shown only if the video fails to open (missing codec, bad file).
             Keeps the app from rendering a blank void in that case. -->
        <Image x:Name="BackgroundFallback"
               Source="Assets/Circuits.png"
               Stretch="UniformToFill"
               Opacity="0.28"
               Visibility="Collapsed"
               IsHitTestVisible="False"/>

        <DockPanel Margin="14">

            <!-- ══ HEADER BAND ══════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderGold}">
                <Border Background="{StaticResource BgPanel}" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mark. Swap Assets/RWS_Mark.png to change the logo;
                             nothing else in the app references it. -->
                        <Image Grid.Column="0" Source="Assets/RWS_Mark.png"
                               Height="72" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>

                        <!-- Wordmark is an image, not type. The obsidian inlay
                             lettering is rendered art and no font reproduces it. -->
                        <Image Grid.Column="1" Source="Assets/RWS_Wordmark.png"
                               Height="62" Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource Eyebrow}"
                                       Text="S E C U R I T Y   A U D I T"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                       HorizontalAlignment="Right" Margin="0,3,0,0"
                                       Text="Audit your AI-coded app before you ship it."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ══ OPTIONS BAR ══════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="2" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Project folder to scan"/>

                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MIN SEVERITY" Style="{StaticResource Eyebrow}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="104"
                                  ItemsSource="{Binding SeverityLevels}"
                                  SelectedItem="{Binding MinSeverity}"/>
                    </StackPanel>

                    <CheckBox Grid.Column="3" Content="Roast" Margin="18,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding Roast}"/>
                    <CheckBox Grid.Column="4" Content="Student mode" Margin="14,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding StudentMode}"/>

                    <Button Grid.Column="5" Content="SCAN" Margin="20,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}"/>
                </Grid>
            </Border>

            <!-- ══ STATUS STRIP ═════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                    Background="{StaticResource BgStatusBar}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="2" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextCode}"
                               Text="{Binding StatusText}"/>
                    <ProgressBar Grid.Column="1" Width="150" Height="5"
                                 IsIndeterminate="{Binding IsScanning}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ══ BODY ═════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <!-- Findings -->
                <Border Grid.Column="0" Margin="0,0,12,0"
                        Background="{StaticResource BgSurface}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" CornerRadius="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="14,10,0,8"
                                   Style="{StaticResource SectionLabel}"
                                   Text="F I N D I N G S"/>
                        <DataGrid ItemsSource="{Binding Findings}"
                                  SelectedItem="{Binding SelectedFinding}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0,1,0,0"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="SEVERITY" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SeverityWash}"
                                                    BorderBrush="{Binding SeverityBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2" Padding="7,3">
                                                <TextBlock Text="{Binding SeverityLabel}"
                                                           Foreground="{Binding SeverityBrush}"
                                                           FontWeight="Bold" FontSize="10"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RULE" Binding="{Binding RuleId}" Width="122">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="FILE" Binding="{Binding File}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextCode}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="LINE" Binding="{Binding Line}" Width="54"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Right rail: grade, then the severity block, then detail -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── GRADE ───────────────────────────────────────── -->
                    <Border Grid.Row="0" Margin="0,0,0,12"
                            Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderGold}"
                            BorderThickness="1" CornerRadius="2" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="96" Height="96"
                                    CornerRadius="48"
                                    Background="{StaticResource BgPanel}"
                                    BorderBrush="{Binding GradeBrush}"
                                    BorderThickness="3">
                                <TextBlock Text="{Binding GradeText}"
                                           Foreground="{Binding GradeBrush}"
                                           FontSize="46" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Eyebrow}" Text="S C O R E"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Score}"
                                               Foreground="{StaticResource GoldGradient}"
                                               FontSize="42" FontWeight="Bold"/>
                                    <TextBlock Text="/100" Foreground="{StaticResource TextMuted}"
                                               FontSize="15" VerticalAlignment="Bottom"
                                               Margin="3,0,0,8"/>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                           Text="{Binding FilesScanned, StringFormat='{}{0} files'}"/>
                                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                           Text="{Binding DurationText, StringFormat='{}{0} elapsed'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── SEVERITY BREAKDOWN — the reason the app exists ─ -->
                    <Border Grid.Row="1" Margin="0,0,0,12"
                            Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1" CornerRadius="2" Padding="10,10,10,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Margin="6,0,0,8"
                                       Text="S E V E R I T Y"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SevCard}"
                                        Background="{StaticResource SevCriticalWash}"
                                        BorderBrush="{StaticResource SevCritical}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SevNumeral}"
                                                   Foreground="{StaticResource SevCritical}"
                                                   Text="{Binding CriticalCount}"/>
                                        <TextBlock Style="{StaticResource SevName}"
                                                   Foreground="{StaticResource SevCritical}"
                                                   Text="CRITICAL"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SevCard}"
                                        Background="{StaticResource SevHighWash}"
                                        BorderBrush="{StaticResource SevHigh}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SevNumeral}"
                                                   Foreground="{StaticResource SevHigh}"
                                                   Text="{Binding HighCount}"/>
                                        <TextBlock Style="{StaticResource SevName}"
                                                   Foreground="{StaticResource SevHigh}"
                                                   Text="HIGH"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SevCard}"
                                        Background="{StaticResource SevMediumWash}"
                                        BorderBrush="{StaticResource SevMedium}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SevNumeral}"
                                                   Foreground="{StaticResource SevMedium}"
                                                   Text="{Binding MediumCount}"/>
                                        <TextBlock Style="{StaticResource SevName}"
                                                   Foreground="{StaticResource SevMedium}"
                                                   Text="MEDIUM"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SevCard}"
                                        Background="{StaticResource SevLowWash}"
                                        BorderBrush="{StaticResource SevLow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SevNumeral}"
                                                   Foreground="{StaticResource SevLow}"
                                                   Text="{Binding LowCount}"/>
                                        <TextBlock Style="{StaticResource SevName}"
                                                   Foreground="{StaticResource SevLow}"
                                                   Text="LOW"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="4,10,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Export JSON" Margin="0,0,4,0"
                                        Command="{Binding ExportJsonCommand}"/>
                                <Button Grid.Column="1" Content="Export HTML" Margin="4,0,0,0"
                                        Command="{Binding ExportHtmlCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── SELECTED FINDING ────────────────────────────── -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1" CornerRadius="2" Padding="14,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="W H Y   T H I S   M A T T E R S"/>
                                <TextBlock Text="{Binding SelectedFinding.Why}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,14"/>
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Foreground="{StaticResource Turquoise}"
                                           Text="F I X"/>
                                <TextBlock Text="{Binding SelectedFinding.Fix}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextCode}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
