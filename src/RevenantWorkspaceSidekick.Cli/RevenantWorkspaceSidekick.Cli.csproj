<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>rws</AssemblyName>
    <RootNamespace>RevenantWorkspaceSidekick.Cli</RootNamespace>

    <!-- Ship metadata -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Revenant Workspace Sidekick</Product>
    <AssemblyTitle>rws</AssemblyTitle>
    <Company>Revenant Systems LLC</Company>
    <Authors>Revenant Systems LLC</Authors>
    <Copyright>Copyright © 2026 Revenant Systems LLC</Copyright>
    <Description>Windows-focused hardening scanner for AI-coded desktop apps. Audits MSIX, registry, process launch, and embedded secrets before you ship.</Description>

    <!-- Same Vegvisir mark the UI uses. Deliberately a local copy rather than a
         ..\ path into the Ui project: ApplicationIcon reaching outside its own
         project directory is fragile across SDK versions, and this file never
         changes. Source of truth is
         src\RevenantWorkspaceSidekick.Ui\Assets\RWS_VegVisir.ico. -->
    <ApplicationIcon>Assets\RWS_VegVisir.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RevenantWorkspaceSidekick.Core\RevenantWorkspaceSidekick.Core.csproj" />
    <ProjectReference Include="..\RevenantWorkspaceSidekick.Rules\RevenantWorkspaceSidekick.Rules.csproj" />
  </ItemGroup>
</Project>
